# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VK OAuth Application Credentials
# ID вашего приложения ВКонтакте из кабинета разработчика https://dev.vk.com
VK_CLIENT_ID="12345678"

# Защищенный ключ (Client Secret) вашего приложения VK
VK_CLIENT_SECRET="your_vk_client_secret_here"

# (Опционально) Redirect URI. По умолчанию: ${APP_URL}/api/auth/vk/callback
VK_REDIRECT_URI=""

# Секрет для подписи сессий (опционально)
SESSION_SECRET="super-secret-random-key"

# Режим тестирования / демонстрации (true/false)
# Если true или ключи VK не заданы, доступен быстрый просмотр демо-данных
DEMO_MODE="false"
